<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Cleartext is only needed because the local updates server is plain HTTP. -->
  <application
    android:allowBackup="false"
    android:label="Brownfield host"
    android:usesCleartextTraffic="true"
    android:theme="@style/Theme.AppCompat.Light.NoActionBar">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- The Activity from expo-brownfield's guide, opened with repro://docs -->
    <activity
      android:name=".DocsExampleActivity"
      android:exported="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="repro" android:host="docs" />
      </intent-filter>
    </activity>
  </application>
</manifest>
